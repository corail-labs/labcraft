labcraft 1

use string
use visa

/// SCPI query whose response is an integer; `string.parse` if it is not one.
fn query_i32(
    session: visa.session,
    command: string,
    err: error = none,
) -> (session: visa.session, value: i32, err: error) {
    text, s, e1 = visa.query(session, command, err: err)
    value, e2 = string.to_i32(text, err: e1)
    session = s
    err = e2
}
