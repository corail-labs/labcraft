labcraft 1

use string
use visa

/// SCPI query whose response is a number; `string.parse` if it is not one.
fn query_f64(
    session: visa.session,
    command: string,
    err: error = none,
) -> (value: f64, session: visa.session, err: error) {
    text, s, e1 = visa.query(session, command, err: err)
    value, e2 = string.to_f64(text, err: e1)
    session = s
    err = e2
}
