labcraft 1

/// The magnitude of `x`.
/// The block of a primitive of `core` (appendix A.1): this file gives its terminals and its outline; its signature
/// is that of appendix A.1, which this one follows as far as the grammar writes it.
extern rust(crate: "labcraft-runtime", function: "abs")
fn abs<N: Number>(x: N) -> (result: N)

terminals {
    top 1
    left 1
    left middle x
    right middle result
    fill "#64748B"
}

outline {
    template primitive
}

icon 32 {
    path "M5.5 10v12" width 2.5
    path "M18.5 10v12" width 2.5
    path "M9.75 13.75l4.5 4.5" width 2.5
    path "M14.25 13.75l-4.5 4.5" width 2.5
}
