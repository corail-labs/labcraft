labcraft 1

/// Whether `a` is below or equal to `b`.
/// The block of a primitive of `core` (appendix A.1): this file gives its terminals and its outline; its signature
/// is that of appendix A.1, which this one follows as far as the grammar writes it.
extern rust(crate: "labcraft-runtime", function: "le")
fn le<N: Number>(a: N, b: N) -> (result: bool)

terminals {
    top 2
    left 3
    left 1 a
    left last b
    right middle result
    fill "#64748B"
}

outline {
    template d
}

icon 32 {
    path "M21.444 20.667l-10.889 -3.111" width 2.333
    path "M21.444 17.556l-10.889 -3.111l10.889 -3.111" width 2.333
}
