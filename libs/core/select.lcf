labcraft 1

/// `if_true` when `condition` is true, else `if_false`.
/// The block of a primitive of `core` (appendix A.1): this file gives its terminals and its outline; its signature
/// is that of appendix A.1, which this one follows as far as the grammar writes it.
extern rust(crate: "labcraft-runtime", function: "select")
fn select<T>(condition: bool, if_true: T, if_false: T) -> (result: T)

terminals {
    top 1
    left 3
    right middle result
    fill "#7E6B8C"
}

outline {
    template primitive
}

icon 32 {
    path "M12.889 12.889a2.722 2.333 0 0 1 2.722 -2.333h0.778a2.722 2.333 0 0 1 2.722 2.333a2.333 2.333 0 0 1 -1.556 2.333a2.333 3.111 0 0 0 -1.556 3.111" width 2.333
    path "M16 21.444l0 0.008" width 2.333
}
