labcraft 1

/// Whether `a` and `b` hold different values.
/// The block of a primitive of `core` (appendix A.1): this file gives its terminals and its outline; its signature
/// is that of appendix A.1, which this one follows as far as the grammar writes it.
extern rust(crate: "labcraft-runtime", function: "ne")
fn ne<T>(a: T, b: T) -> (result: bool)

terminals {
    top 2
    left 3
    left 1 a
    left last b
    right middle result
    fill "#64748B"
}

outline {
    template d
}

icon 32 {
    path "M10.556 14.444h10.889" width 2.333
    path "M10.556 17.556h10.889" width 2.333
    path "M10.556 21.444l10.889 -10.889" width 2.333
}
