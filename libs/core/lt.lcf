labcraft 1

/// Whether `a` is below `b`.
/// The block of a primitive of `core` (appendix A.1): this file gives its terminals and its outline; its signature
/// is that of appendix A.1, which this one follows as far as the grammar writes it.
extern rust(crate: "labcraft-runtime", function: "lt")
fn lt<N: Number>(a: N, b: N) -> (result: bool)

terminals {
    top 3
    left 3
    left 1 a
    left last b
    right middle result
}

outline {
    template d
}
