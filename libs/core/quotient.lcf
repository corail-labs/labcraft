labcraft 1

/// `a` divided by `b`, rounded toward minus infinity.
/// The block of a primitive of `core` (appendix A.1): this file gives its terminals and its outline; its signature
/// is that of appendix A.1, which this one follows as far as the grammar writes it.
extern rust(crate: "labcraft-runtime", function: "quotient")
fn quotient<I: Integer>(a: I, b: I) -> (result: I)

terminals {
    top 1
    left 3
    left 1 a
    left last b
    right middle result
    fill "#686B9E"
}

outline {
    template primitive
}

icon 32 {
    path "M14.444 10.556l-4.667 10.889" width 2.333
    path "M22.222 10.556l-4.667 10.889" width 2.333
}
