labcraft 1

/// `x` in the unit given, `core.with_unit(raw, [V])`: its type is `f64[unit]`, and its unit, `unit: kind unit`, is no terminal (appendix A.1).
/// The block of a primitive of `core` (appendix A.1): this file gives its terminals and its outline; its signature
/// is that of appendix A.1, which this one follows as far as the grammar writes it.
extern rust(crate: "labcraft-runtime", function: "with_unit")
fn with_unit(x: f64) -> (result: f64)

terminals {
    top 3
    left 3
    left middle x
    right middle result
}

outline {
    template d
}
