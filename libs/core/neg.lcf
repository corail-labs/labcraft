labcraft 1

/// The opposite of `x`.
/// The block of a primitive of `core` (appendix A.1): this file gives its terminals and its outline; its signature
/// is that of appendix A.1, which this one follows as far as the grammar writes it.
extern rust(crate: "labcraft-runtime", function: "neg")
fn neg<N: Number>(x: N) -> (result: N)

terminals {
    top 1
    left 1
    left middle x
    right middle result
    fill "#64748B"
}

outline {
    template primitive
}

icon 32 {
    path "M7.833 16l16.333 0" width 3.5
}
