labcraft 1

/// Whether `a` and `b` hold the same value (appendix A.1).
/// The block of a primitive of `core` (appendix A.1): this file gives its terminals and its outline; its signature
/// is that of appendix A.1, which this one follows as far as the grammar writes it.
extern rust(crate: "labcraft-runtime", function: "eq")
fn eq<T>(a: T, b: T) -> (result: bool)

terminals {
    top 1
    left 3
    left 1 a
    left last b
    right middle result
    fill "#557F88"
}

outline {
    template primitive
}

icon 32 {
    path "M10 12.5h12" width 2.5
    path "M10 19.5h12" width 2.5
}
