labcraft 1

/// `a` divided by `b`, whose type is `A/B` (appendix A.1).
/// The block of a primitive of `core` (appendix A.1): this file gives its terminals and its outline; its signature
/// is that of appendix A.1, which this one follows as far as the grammar writes it.
extern rust(crate: "labcraft-runtime", function: "div")
fn div<A: Number, B: Number, R: Number>(a: A, b: B) -> (result: R)

terminals {
    top 3
    left 3
    left 1 a
    left last b
    right middle result
}

outline {
    template d
}
