labcraft 1

/// The greater of `a` and `b`.
/// The block of a primitive of `core` (appendix A.1): this file gives its terminals and its outline; its signature
/// is that of appendix A.1, which this one follows as far as the grammar writes it.
extern rust(crate: "labcraft-runtime", function: "max")
fn max<N: Number>(a: N, b: N) -> (result: N)

terminals {
    top 1
    left 3
    left 1 a
    left last b
    right middle result
    fill "#64748B"
}

outline {
    template primitive
}

icon 32 {
    path "M12.5 18.5V9a3.5 3.5 0 0 1 7 0V18.5" width 2.5
    circle (16, 22.5) 5 width 2.5 fill
    path "M16 19V9" width 4
}
