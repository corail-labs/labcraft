labcraft 1

/// The product of `a` and `b`, whose type is `A·B` (appendix A.1).
/// The block of a primitive of `core` (appendix A.1): this file gives its terminals and its outline; its signature
/// is that of appendix A.1, which this one follows as far as the grammar writes it.
extern rust(crate: "labcraft-runtime", function: "mul")
fn mul<A: Number, B: Number, R: Number>(a: A, b: B) -> (result: R)

terminals {
    top 1
    left 3
    left 1 a
    left last b
    right middle result
    fill "#64748B"
}

outline {
    template primitive
}

icon 32 {
    path "M20.667 11.333l-9.333 9.333" width 2.333
    path "M11.333 11.333l9.333 9.333" width 2.333
}
