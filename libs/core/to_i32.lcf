labcraft 1

/// `x` as an `i32`, toward zero.
/// The block of a primitive of `core` (appendix A.1): this file gives its terminals and its outline; its signature
/// is that of appendix A.1, which this one follows as far as the grammar writes it.
extern rust(crate: "labcraft-runtime", function: "to_i32")
fn to_i32(x: f64) -> (result: i32)

terminals {
    top 2
    left 1
    left middle x
    right middle result
    fill "#7F7464"
}

outline {
    template primitive
}

icon 32 {
    text "i32" at (16, 21.5) size 16
}
