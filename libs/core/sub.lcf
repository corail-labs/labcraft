labcraft 1

/// `a` minus `b`, of the same dimension, in the unit of `a`.
/// The block of a primitive of `core` (appendix A.1): this file gives its terminals and its outline; its signature
/// is that of appendix A.1, which this one follows as far as the grammar writes it.
extern rust(crate: "labcraft-runtime", function: "sub")
fn sub<N: Number>(a: N, b: N) -> (result: N)

terminals {
    top 1
    left 3
    left 1 a
    left last b
    right middle result
    fill "#64748B"
}

outline {
    template primitive
}

icon 32 {
    path "M10.556 16l10.889 0" width 2.333
}
