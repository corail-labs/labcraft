labcraft 1

/// Whether `a` or `b` is true; on integers, the bits set in either.
/// The block of a primitive of `core` (appendix A.1): this file gives its terminals and its outline; its signature
/// is that of appendix A.1, which this one follows as far as the grammar writes it.
extern rust(crate: "labcraft-runtime", function: "or")
fn or<B: Bits>(a: B, b: B) -> (result: B)

terminals {
    top 1
    left 3
    left 1 a
    left last b
    right middle result
    fill "#686B9E"
}

outline {
    template primitive
}

icon 32 {
    path "M11.333 12.111l4.667 7.778l4.667 -7.778" width 2.333
}
