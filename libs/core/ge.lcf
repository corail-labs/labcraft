labcraft 1

/// Whether `a` is above or equal to `b`.
/// The block of a primitive of `core` (appendix A.1): this file gives its terminals and its outline; its signature
/// is that of appendix A.1, which this one follows as far as the grammar writes it.
extern rust(crate: "labcraft-runtime", function: "ge")
fn ge<N: Number>(a: N, b: N) -> (result: bool)

terminals {
    top 1
    left 3
    left 1 a
    left last b
    right middle result
    fill "#557F88"
}

outline {
    template primitive
}

icon 32 {
    path "M10 17l12 -4l-12 -4" width 2.5
    path "M10 23l12 -4" width 2.5
}
