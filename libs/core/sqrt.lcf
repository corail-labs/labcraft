labcraft 1

/// The square root of `x`, whose type is `√N` (appendix A.1).
/// The block of a primitive of `core` (appendix A.1): this file gives its terminals and its outline; its signature
/// is that of appendix A.1, which this one follows as far as the grammar writes it.
extern rust(crate: "labcraft-runtime", function: "sqrt")
fn sqrt<N: Number, R: Number>(x: N) -> (result: R)

terminals {
    top 3
    left 3
    left middle x
    right middle result
}

outline {
    template d
}
