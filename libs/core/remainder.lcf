labcraft 1

/// `a` minus `b` times their quotient: the sign of `b`.
/// The block of a primitive of `core` (appendix A.1): this file gives its terminals and its outline; its signature
/// is that of appendix A.1, which this one follows as far as the grammar writes it.
extern rust(crate: "labcraft-runtime", function: "remainder")
fn remainder<I: Integer>(a: I, b: I) -> (result: I)

terminals {
    top 1
    left 3
    left 1 a
    left last b
    right middle result
    fill "#686B9E"
}

outline {
    template primitive
}

icon 32 {
    path "M21.444 10.556l-10.889 10.889" width 2.333
    circle (11.333, 11.333) 1.556 width 2.333
    circle (20.667, 20.667) 1.556 width 2.333
}
