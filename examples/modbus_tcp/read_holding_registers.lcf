labcraft 1

use bytes
use core
use errors
use net

/// Reads `count` holding registers, 1 to 125, from `first` (function code 3) of `unit`, over an open connection. A response
/// whose function code has its high bit set is the error `modbus_tcp.exception`, with the exception code as its code; one
/// that is not function 3 with two bytes per register is `modbus_tcp.invalid_response`. With an error, no register.
fn read_holding_registers(
    connection: net.connection,
    unit: u8 = 1,
    first: u16 = 0,
    count: u16 = 1,
    transaction: u16 = 1,
    err: error = none,
) -> (registers: [u16], connection: net.connection, err: error) {
    // Modbus reads 1 to 125 registers at once: another count is refused, and nothing is sent.
    few = core.lt(count, 1)
    many = core.gt(count, 125)
    outside = core.or(few, many)
    asked = core.select(outside, 0, count)
    e0 = errors.raise_if(outside, io.invalid_argument, "the count of registers is from 1 to 125", err: err)
    id, e1 = bytes.from_u16(transaction, err: e0)
    protocol, e2 = bytes.from_u16(0, err: e1)
    length, e3 = bytes.from_u16(6, err: e2)
    to, e4 = bytes.from_u8(unit, err: e3)
    function, e5 = bytes.from_u8(3, err: e4)
    start, e6 = bytes.from_u16(first, err: e5)
    how_many, e7 = bytes.from_u16(asked, err: e6)
    request = bytes.concat(id, protocol, length, to, function, start, how_many)
    c1, e8 = net.write(connection, request, err: e7)
    header, c2, e9 = net.read(c1, 7, err: e8)
    size, e10 = bytes.read_u16(header, 4, err: e9)
    // The length counts the unit byte, already read; an `i32`, so that a length of 0 gives -1, which `net.read` refuses.
    unit_byte = bytes.len(to)
    rest = core.sub(size, unit_byte)
    pdu, c3, e11 = net.read(c2, rest, err: e10)
    code, e12 = bytes.read_u8(pdu, 0, err: e11)
    high = core.and(code, 0x80)
    e13 = match high {
        0 => {
            // Function 3, then the count of bytes that follow, two per register, which the length of the header holds too.
            counted, e14 = bytes.read_u8(pdu, 1, err: e12)
            expected = core.mul(asked, 2)
            framed = core.add(expected, 3)
            sized = core.eq(counted, expected)
            three = core.eq(code, 3)
            whole = core.eq(size, framed)
            counted_right = core.and(sized, whole)
            right = core.and(three, counted_right)
            wrong = core.not(right)
            e15 = errors.raise_if(wrong, modbus_tcp.invalid_response, "not function 3 with two bytes per register", err: e14)
            yield e15
        }
        _ => {
            exception, e16 = bytes.read_u8(pdu, 1, err: e12)
            refused = errors.make(modbus_tcp.exception, code: exception, message: "exception response to function 3")
            e17 = errors.merge(e16, refused)
            yield e17
        }
    }
    // A response in error holds no register that can be trusted: none is read.
    n = handle e13 {
        ok => yield asked
        _ => yield 0
    }
    err_out, registers = for i in 0..n, carry e = e13 {
        offset = core.mul(i, 2)
        at = core.add(offset, 2)
        value, e18 = bytes.read_u16(pdu, at, err: e)
        next e = e18
        collect value
    }
    connection = c3
    err = err_out
}
