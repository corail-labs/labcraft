labcraft 1

/// The supply voltage of a channel. Channel 1 is the default one: a channel with no branch of its
/// own gets its voltage.
fn channel_voltage(channel: i32) -> (voltage: f64[V]) {
    voltage = match channel {
        1, _ => yield 5 V
        2 => yield 12 V
        3..=5, 8 => yield 24 V
    }
}
