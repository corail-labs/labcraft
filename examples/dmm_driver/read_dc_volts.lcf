labcraft 1

use scpi
use visa

/// Reads the DC voltage of a multimeter.
fn read_dc_volts(
    session: visa.session,
    err: error = none,
) -> (volts: f64[V], session: visa.session, err: error) {
    raw, s, e1 = scpi.query_f64(session, "MEAS:VOLT:DC?", err: err)
    volts = with_unit(raw, [V])
    session = s
    err = e1
}
