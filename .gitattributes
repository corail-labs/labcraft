# LabCraft sources use LF line endings (spec v0, section 2)
*.lcf text eol=lf
*.lct text eol=lf

# The snapshots of the IR are compared byte for byte with what `ir::print` writes (docs/ir.md, section 8)
*.ir text eol=lf

# A CR breaks a shell script, on Windows too
*.sh text eol=lf

# Hostile files are stored byte for byte (CR LF, BOM, invalid UTF-8)
tests/acceptance/hostile/** -text

# FigCraft files are zip archives
*.figcraft binary

# Fonts, and the data of Unicode byte for byte (its SHA-256 is in ATTRIBUTION.md and the generated tables)
*.ttf binary
crates/types/tests/data/** -text
