fn two_benches(resource_a: string = "SIM::DMM0", resource_b: string = "SIM::DMM1", count: f64 = 10.0, period: duration = 100000000 ns) -> (mean_a: f64, mean_b: f64, err: error)
  element stop_switch: switch bool = false
  region (resource_a, resource_b, count, period) -> (mean_a, mean_b, err)
    0 dmm_a, ea = native visa.open(resource_a, 500000000 ns, none)  skip(err: 2)
    1 dmm_b, eb = native visa.open(resource_b, 500000000 ns, none)  skip(err: 2)
    2 n_a, sum_a, err_a = loop (carries 3, collects 0) (0.0, 0.0, ea, count, dmm_a, period)
      region (n, s, e, count, dmm_a, period) -> (m, next.s, e2, halt)
        0 m = primitive core.add(n, 1.0)
        1 full = primitive core.ge(m, count)
        2 x, _, e1 = call scpi.query_f64(dmm_a, "MEAS:VOLT:DC?", e)  runs
        3 e2 = primitive time.wait(period, e1)  skip(err: 1)
        4 stop = primitive ui.get(element stop_switch) after(e2)
        5 halt = primitive core.or(full, stop)
        8 @29: next.s = primitive core.add(s, x)
    3 ca = native visa.close(dmm_a, err_a)  skip(err: 1, always)
    4 mean_a = primitive core.div(sum_a, n_a)
    5 n_b, sum_b, err_b = loop (carries 3, collects 0) (0.0, 0.0, eb, count, dmm_b, period)
      region (n, s, e, count, dmm_b, period) -> (m, next.s, e2, halt)
        0 m = primitive core.add(n, 1.0)
        1 full = primitive core.ge(m, count)
        2 x, _, e1 = call scpi.query_f64(dmm_b, "MEAS:VOLT:DC?", e)  runs
        3 e2 = primitive time.wait(period, e1)  skip(err: 1)
        4 stop = primitive ui.get(element stop_switch) after(e2)
        5 halt = primitive core.or(full, stop)
        8 @43: next.s = primitive core.add(s, x)
    6 cb = native visa.close(dmm_b, err_b)  skip(err: 1, always)
    7 err = primitive errors.merge(ca, cb)
    8 mean_b = primitive core.div(sum_b, n_b)
