fn modbus_tcp.read_holding_registers(connection: net.connection, unit: u8 = 1, first: u16 = 0, count: u16 = 1, transaction: u16 = 1, err: error = none) -> (registers: [u16], connection: net.connection, err: error)
  region (connection, unit, first, count, transaction, err) -> (registers, c3, err_out)
    0 few = primitive core.lt(count, 1)
    1 many = primitive core.gt(count, 125)
    2 outside = primitive core.or(few, many)
    3 asked = primitive core.select(outside, 0, count)
    4 e0 = primitive errors.raise_if(outside, "the count of registers is from 1 to 125", err, io.invalid_argument)  skip(err: 2)
    5 id, e1 = primitive bytes.from_u16(transaction as i64, false, e0)  skip(err: 2)
    6 protocol, e2 = primitive bytes.from_u16(0, false, e1)  skip(err: 2)
    7 length, e3 = primitive bytes.from_u16(6, false, e2)  skip(err: 2)
    8 to, e4 = primitive bytes.from_u8(unit as i64, e3)  skip(err: 1)
    9 function, e5 = primitive bytes.from_u8(3, e4)  skip(err: 1)
    10 start, e6 = primitive bytes.from_u16(first as i64, false, e5)  skip(err: 2)
    11 how_many, e7 = primitive bytes.from_u16(asked as i64, false, e6)  skip(err: 2)
    12 request = primitive bytes.concat(id, protocol, length, to, function, start, how_many)
    13 c1, e8 = native net.write(connection, request, e7)  skip(err: 2)
    14 header, c2, e9 = native net.read(c1, 7, e8)  skip(err: 2)
    15 size, e10 = primitive bytes.read_u16(header, 4, false, e9)  skip(err: 3)
    16 unit_byte = primitive bytes.len(to)
    17 rest = primitive core.sub(size as i32, unit_byte)
    18 pdu, c3, e11 = native net.read(c2, rest, e10)  skip(err: 2)
    19 code, e12 = primitive bytes.read_u8(pdu, 0, e11)  skip(err: 2)
    20 high = primitive core.and(code, 128)
    21 e13 = match (high, pdu, e12, asked, code, size)
      arm 0 (pdu, e12, asked, code, size) -> (e15)
        0 counted, e14 = primitive bytes.read_u8(pdu, 1, e12)  skip(err: 2)
        1 expected = primitive core.mul(asked, 2)
        2 framed = primitive core.add(expected, 3)
        3 sized = primitive core.eq(counted as u16, expected)
        4 three = primitive core.eq(code, 3)
        5 whole = primitive core.eq(size, framed)
        6 counted_right = primitive core.and(sized, whole)
        7 right = primitive core.and(three, counted_right)
        8 wrong = primitive core.not(right)
        9 e15 = primitive errors.raise_if(wrong, "not function 3 with two bytes per register", e14, modbus_tcp.invalid_response)  skip(err: 2)
      arm _ (pdu, e12, asked, code, size) -> (e17)
        0 exception, e16 = primitive bytes.read_u8(pdu, 1, e12)  skip(err: 2)
        1 refused = primitive errors.make(exception as i32, "exception response to function 3", modbus_tcp.exception)
        2 e17 = primitive errors.merge(e16, refused)
    22 n = handle (e13, asked)
      arm ok (asked) -> (asked)
      arm _ (asked) -> (0)
    23 err_out, registers = for [range] (carries 1, collects 1) (0, n, e13, pdu)
      region (i, e, pdu) -> (e18, value)
        0 offset = primitive core.mul(i, 2)
        1 at = primitive core.add(offset, 2)
        2 value, e18 = primitive bytes.read_u16(pdu, at as i32, false, e)  skip(err: 3)
