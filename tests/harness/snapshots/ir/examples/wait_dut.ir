fn wait_dut(bench: Bench, timeout: duration, err: error = none) -> (present: bool, err: error)
  region (bench, timeout, err) -> (present, err_out)
    0 t0 = primitive time.now() after(err)
    1 present, err_out = loop (carries 2, collects 0) (false, err, bench, t0, timeout)
      region (p, e, bench, t0, timeout) -> (here, next.e, done)
        0 level, _, e1 = call scpi.query_f64(bench.relays, "DUT:PRES?", e)  runs
        1 here = primitive core.gt(level, 0.5)
        2 absent = primitive core.not(here)
        3 pause = primitive core.select(here, 0.0 ms, 100.0 ms)
        4 e2 = primitive time.wait(pause as duration (/1000.0), e1)  skip(err: 1)
        5 t = primitive time.elapsed(t0)
        6 late = primitive core.gt(t as f64[s], timeout as f64[s])
        7 give_up = primitive core.and(late, absent)
        8 done = primitive core.or(here, give_up)
        9 @21: next.e = primitive errors.raise_if(give_up, "product absent", e2, io.timeout)  skip(err: 2)
