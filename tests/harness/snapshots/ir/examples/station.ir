fn station(bench: Bench, steps: [Step], dut_count: i32 = 1, err: error = none) -> (err: error)
  region (bench, steps, dut_count, err) -> (err_out)
    0 n = primitive array.len(steps)
    1 _, _, _, _, err_out = loop (carries 5, collects 0) (State.Init, 0, [], 0, err, bench, n, steps, dut_count)
      region (state, index, results, tested, err, bench, n, steps, dut_count) -> (next.state, next.index, next.results, next.tested, next.err, stop)
        0 next.state, next.index, next.results, next.tested, next.err, stop = match (state, bench, err, results, tested, index, n, steps, dut_count)
          arm Init (bench, err, results, tested, index, n, steps, dut_count) -> (State.WaitDut, 0, results, tested, e1, false)
            0 e1 = call bench_selftest(bench, err)  runs
          arm WaitDut (bench, err, results, tested, index, n, steps, dut_count) -> (s, 0, [], tested, e2, false)
            0 present, e2 = call wait_dut(bench, 30000000000 ns, err)  runs
            1 s = primitive core.select(present, State.RunStep, State.WaitDut)
          arm RunStep (bench, err, results, tested, index, n, steps, dut_count) -> (s, i2, all, tested, e3, false)
            0 i2 = primitive core.add(index, 1)
            1 more = primitive core.lt(i2, n)
            2 step, e5 = primitive array.get(steps, index, err)  skip(err: 2)
            3 r, e3 = call run_step(bench, step, e5)  runs
            4 all = primitive array.push(results, r)
            5 go_on = primitive core.and(more, r.passed)
            6 s = primitive core.select(go_on, State.RunStep, State.Report)
          arm Report (bench, err, results, tested, index, n, steps, dut_count) -> (s, 0, [], t2, e4, false)
            0 e4 = native results_log.append_csv(results, err)  skip(err: 1)
            1 t2 = primitive core.add(tested, 1)
            2 again = primitive core.lt(t2, dut_count)
            3 s = primitive core.select(again, State.WaitDut, State.Stop)
          arm Stop (bench, err, results, tested, index, n, steps, dut_count) -> (State.Stop, index, results, tested, err, true)
