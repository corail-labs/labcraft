fn projectile(vx0: f64[m/s], vy0: f64[m/s], mass: f64[kg], drag: f64[kg/m] = 0.0 kg/m, dt: f64[s] = 0.01 s) -> (flight_time: f64[s], range: f64[m], apex: f64[m])
  element vx0: numeric f64[m/s] (input 0)
  element vy0: numeric f64[m/s] (input 1)
  element mass: numeric f64[kg] (input 2)
  element drag: numeric f64[kg/m] = 0.0 kg/m (input 3)
  element dt: numeric f64[s] = 0.01 s (input 4)
  element flight_time: numeric f64[s] = 0.0 s (output 0)
  element range: numeric f64[m] = 0.0 m (output 1)
  element apex: numeric f64[m] = 0.0 m (output 2)
  region (vx0, vy0, mass, drag, dt) -> (flight_time, range, apex)
    0 g = constant 9.81 m/s^2
    1 k = primitive core.div(drag, mass)
    2 flight_time, range, _, _, _, apex = loop (carries 6, collects 0) (0.0 s, 0.0 m, 0.0 m, vx0, vy0, 0.0 m, dt, k)
      region (t, x, y, vx, vy, top, dt, k) -> (next.t, next.x, ny, next.vx, next.vy, next.top, landed)
        0 dx = primitive core.mul(vx, dt)
        1 dy = primitive core.mul(vy, dt)
        2 ny = primitive core.add(y, dy)
        3 landed = primitive core.le(ny, 0.0 m)
        4 vx2 = primitive core.mul(vx, vx)
        5 vy2 = primitive core.mul(vy, vy)
        6 v2 = primitive core.add(vx2, vy2)
        7 speed = primitive core.sqrt(v2)
        8 ks = primitive core.mul(k, speed)
        9 kvx = primitive core.mul(ks, vx)
        10 ax = primitive core.neg(kvx)
        11 dvx = primitive core.mul(ax, dt)
        12 kvy = primitive core.mul(ks, vy)
        13 drag_y = primitive core.neg(kvy)
        14 ay = primitive core.sub(drag_y, 9.81 m/s^2)
        15 dvy = primitive core.mul(ay, dt)
        16 @41: next.t = primitive core.add(t, dt)
        17 @42: next.top = primitive core.max(top, ny)
        18 @43: next.vx = primitive core.add(vx, dvx)
        19 @44: next.vy = primitive core.add(vy, dvy)
        20 @45: next.x = primitive core.add(x, dx)
