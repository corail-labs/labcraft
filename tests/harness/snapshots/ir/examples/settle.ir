fn settle(dmm: visa.session, target: f64[V], tolerance: f64[V], period: duration, timeout: duration, err: error = none) -> (value: f64[V], err: error)
  region (dmm, target, tolerance, period, timeout, err) -> (value, err_out)
    0 t0 = primitive time.now() after(err)
    1 value, err_out = loop (carries 2, collects 0) (0.0 V, err, period, t0, timeout, dmm, target, tolerance)
      region (v, e, period, t0, timeout, dmm, target, tolerance) -> (x, next.e, done)
        0 e1 = primitive time.wait(period, e)  skip(err: 1)
        1 t = primitive time.elapsed(t0)
        2 late = primitive core.gt(t as f64[s], timeout as f64[s])
        3 x, _, e2 = call dmm_driver.read_dc_volts(dmm, e1)  runs
        4 gap = primitive core.sub(x, target)
        5 dist = primitive core.abs(gap)
        6 stable = primitive core.le(dist, tolerance)
        7 done = primitive core.or(stable, late)
        8 @28: next.e = primitive errors.raise_if(late, "reading not settled", e2, io.timeout)  skip(err: 2)
