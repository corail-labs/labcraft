fn scpi.check_errors(session: visa.session, err: error = none) -> (session: visa.session, err: error)
  region (session, err) -> (s, merged)
    0 s, _, found, e1 = loop continue_on_error (carries 4, collects 0) (session, 0, none, err)
      region (current, i, seen, e) -> (s2, i2, added, e4, stop)
        0 i2 = primitive core.add(i, 1)
        1 full = primitive core.ge(i2, 20)
        2 text, s2, e2 = native visa.query(current, "SYST:ERR?", e)  skip(err: 2)
        3 parts = primitive string.split(text, ",")
        4 first, e3 = primitive array.get(parts, 0, e2)  skip(err: 2)
        5 code, e4 = primitive string.to_i32(first, e3)  skip(err: 1)
        6 done = primitive core.eq(code, 0)
        7 added = match (done, seen, code, text)
          arm true (seen, code, text) -> (seen)
          arm false (seen, code, text) -> (all)
            0 one = primitive errors.make(code, text, scpi.instrument_error)
            1 all = primitive errors.merge(seen, one)
        8 stop = primitive core.or(done, full)
    1 merged = primitive errors.merge(e1, found)
