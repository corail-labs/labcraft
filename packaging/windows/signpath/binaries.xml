<?xml version="1.0" encoding="utf-8"?>
<!-- The artifact configuration `binaries` of the project `labcraft` on SignPath (architecture.md 8): what the step
     "Sign the binaries" of the workflow `release` sends, the zip of the two programs. This file is the reference; the
     configuration on SignPath is pasted from it, and changed here first. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="labcraft.exe">
      <authenticode-sign />
    </pe-file>
    <pe-file path="labcraft-cli.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
